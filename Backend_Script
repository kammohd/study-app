// No API calls: proves the grounding helpers behave. Run it after pasting this file.
function testGrounding() {
  function eq(a, b, msg) { if (JSON.stringify(a) !== JSON.stringify(b)) throw new Error("FAIL " + msg + ": " + JSON.stringify(a) + " != " + JSON.stringify(b)); }
  var good = { question: "What does a hash map give on average?", options: ["O(1) lookup", "O(n) lookup", "O(log n) lookup", "No lookup"], correct: 0 };
  eq(okQ_(good), true, "valid question accepted");
  eq(okQ_({ question: "short", options: ["a", "b", "c", "d"], correct: 0 }), false, "short question rejected");
  eq(okQ_({ question: "A long enough question here?", options: ["a", "a", "c", "d"], correct: 0 }), false, "duplicate options rejected");
  eq(okQ_({ question: "A long enough question here?", options: ["a", "b", "c"], correct: 0 }), false, "3 options rejected");
  eq(okQ_({ question: "A long enough question here?", options: ["a", "b", "c", "d"], correct: 4 }), false, "answer index out of range rejected");
  var s = shuffleQ_({ question: good.question, options: good.options.slice(), correct: 0 });
  eq(s.options[s.correct], "O(1) lookup", "shuffle keeps the right answer right");
  var src = "Hash maps and sets give average O(1) lookup, insert and delete. Typical uses: detect duplicates, count frequencies.";
  eq(quoteInSource_("give average O(1) lookup, insert and delete", src), true, "real quote accepted");
  eq(quoteInSource_("hash maps always give worst case constant time lookup guaranteed", src), false, "invented quote rejected");
  Logger.log("testGrounding: all checks passed");
}
